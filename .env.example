# ============================================================
# ANALISIS UJIAN SEKOLAH — Environment Variables
# Salin file ini menjadi .env.local dan isi nilainya
# JANGAN commit file .env.local ke Git!
# ============================================================

# --- SUPABASE (Required untuk Produksi) ---
# Dapatkan dari: https://app.supabase.com -> Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# --- GOOGLE OAUTH (Opsional, untuk integrasi Google Sheets API) ---
# Dapatkan dari: https://console.cloud.google.com
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=YOUR_GOOGLE_SHEETS_API_KEY

# --- APP CONFIG ---
VITE_APP_NAME=Analisis Ujian Sekolah
VITE_APP_URL=http://localhost:3000

# --- SERVER SIDE (Non-VITE, untuk Node.js/Express jika diperlukan) ---
APP_URL=http://localhost:3000
